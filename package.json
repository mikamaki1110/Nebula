{
  "name": "nebula-desktop",
  "productName": "Nebula",
  "version": "1.4.0",
  "description": "Hardware-Monitor für Windows: Temperaturen, Auslastung, Prozesse und alle Bauteile deines PCs",
  "main": "main.js",
  "author": "Nebula",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "sensors": "powershell -NoProfile -ExecutionPolicy Bypass -File build/fetch-sensors.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "systeminformation": "^5.25.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.nebula.desktop",
    "productName": "Nebula",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "lhm.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nebula",
      "artifactName": "Nebula-Setup-${version}.${ext}",
      "perMachine": true
    },
    "portable": {
      "artifactName": "Nebula-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/lhm",
        "to": "lhm"
      },
      {
        "from": "vendor/PawnIO_setup.exe",
        "to": "PawnIO_setup.exe"
      },
      {
        "from": "build/sensors",
        "to": "sensors",
        "filter": [
          "*.ps1"
        ]
      }
    ]
  }
}